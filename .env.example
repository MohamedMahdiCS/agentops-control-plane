# Copy to .env for local development. Never commit .env or real secrets.

# development | test | production
APP_ENV=development

# PostgreSQL connection (psycopg 3 driver).
DATABASE_URL=postgresql://moyy@localhost:5432/agentops_dev

# Operator authentication for traces, approvals, evaluations and benchmarks.
# Store only the SHA-256 hex digest of a random 32-256 character token:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"      # keep this token private
#   printf %s "<token>" | shasum -a 256                               # put this digest below
# Both values are required when APP_ENV=production.
OPERATOR_TOKEN_SHA256=
OPERATOR_ID=local-operator

# Optional: comma-separated browser origins allowed to call the API directly.
# Leave empty when the UI is served through the same origin (Vite or nginx proxy).
CORS_ORIGINS=

# Optional: where benchmark manifests are written (relative to the project root).
BENCHMARK_DATA_DIR=data/benchmarks/runs
