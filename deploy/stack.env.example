# Values for `docker compose --env-file deploy/stack.env up`.
# Copy to deploy/stack.env (gitignored) and replace every value.

POSTGRES_PASSWORD=change-me-to-a-long-random-password
# SHA-256 hex digest of your operator token (never the token itself):
#   printf %s "<token>" | shasum -a 256
OPERATOR_TOKEN_SHA256=
OPERATOR_ID=operator
WEB_PORT=8080
